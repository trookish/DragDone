<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\DragDone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DragDone</AssemblyName>
    <RootNamespace>DragDone</RootNamespace>
    <Version>1.2.0</Version>
    <Product>DragDone</Product>
    <Company>Turki Alshaalan</Company>
    <Copyright>Copyright © 2026 Turki Alshaalan</Copyright>
    <Description>Drag • Press • Done</Description>
    <!-- The interface is Arabic and English only; framework satellite assemblies for the other
         thirteen languages are dead weight in a tray utility. -->
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\ar.json" LogicalName="DragDone.Localization.ar.json" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="DragDone.Localization.en.json" />
    <Resource Include="Assets\DragDone.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DragDone.Tests" />
  </ItemGroup>

  <!-- The native symbol reader only exists to read PDBs, and this build ships none. -->
  <Target Name="DropSymbolReader" AfterTargets="Publish">
    <ItemGroup>
      <SymbolReaderLeftover Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
    </ItemGroup>
    <Delete Files="@(SymbolReaderLeftover)" />
  </Target>

</Project>
