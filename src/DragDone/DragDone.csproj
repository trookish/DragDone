<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\DragDone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DragDone</AssemblyName>
    <RootNamespace>DragDone</RootNamespace>
    <Version>1.1.0</Version>
    <Product>DragDone</Product>
    <Company>Turki Alshaalan</Company>
    <Copyright>Copyright © 2026 Turki Alshaalan</Copyright>
    <Description>Drag • Press • Done</Description>
    <!-- WPF owns DPI awareness through app.manifest; the WinForms advice does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF both bring these namespaces; keep only the WPF ones implicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\ar.json" LogicalName="DragDone.Localization.ar.json" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="DragDone.Localization.en.json" />
    <Resource Include="Assets\DragDone.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DragDone.Tests" />
  </ItemGroup>

</Project>
